{
  "name": "quicksilver",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "generate:pwa-assets": "pwa-assets-generator",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:attest": "npm run test:e2e && node scripts/attest-e2e.mjs",
    "test:e2e:update": "bash scripts/test-e2e.sh --update-snapshots"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "^1.58.1",
    "@silvia-odwyer/photon": "^0.3.3",
    "@solidjs/web": "2.0.0-rc.9",
    "@stacksjs/ts-avif": "^0.1.4",
    "mediabunny": "1.58.1",
    "solid-js": "2.0.0-rc.9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@vite-pwa/assets-generator": "1.0.4",
    "portless": "^0.15.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.3.0"
  }
